#!/usr/bin/env bash
# Refuse every push. These hooks run only for an agent's commands (shared/env.json), and the
# owner blocks every agent push. git runs this hook however the push was started (alias,
# script, bash -c), so no spelling gets past it.
echo "pre-push: refusing to push to $1; pushes are the owner's, and an agent may not push" >&2
exit 1

# Not reached while every push is refused. These are the checks a push met before; lifting the
# block is deleting the two lines above. Refuse a push outside the org list, and any push that
# deletes a remote ref, then run the repo's own pre-push. git passes the remote name and URL
# as $1 and $2.
dir="$(dirname "$0")"
python3.14 "$dir/_boundary.py" "$2" || exit 1

# One line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>. A deletion
# has an all-zero local sha, whichever spelling asked for it (`:branch`, `--delete`, `-d`),
# so it is caught here rather than by matching command text in the permission rules. The lines are
# kept byte for byte (the trailing `.` stops $(...) eating the last newline) so the repo's
# own pre-push reads exactly what git sent.
refs="$(cat; echo .)"
refs="${refs%.}"
while read -r _ local_sha remote_ref _; do
    if [ -n "$local_sha" ] && [ -z "${local_sha//0/}" ]; then
        echo "pre-push: refusing to delete $remote_ref on $1; deleting a remote branch is the owner's to do" >&2
        exit 1
    fi
done <<<"$refs"

printf '%s' "$refs" | HOOK_NAME=pre-push "$dir/_dispatch" "$@"
