{
  "allow": [
    "find *",
    "grep *",
    "wc *",
    "ls *",
    "git status*",
    "git diff*",
    "git log*",
    "pylint *",
    "python -m pylint *",
    "python -m black --check *",
    "python -m pytest *",
    "python manage.py *",
    ".venv/bin/python manage.py *",
    ".venv/bin/python server/manage.py *",
    "source .venv/bin/activate"
  ],
  "ask": [
    "git commit*",
    "git push*",
    "git -C * push*",
    "bash /tmp/rc-*.sh",
    "*manage.py migrate*",
    "*manage.py makemigrations*",
    "*manage.py squashmigrations*",
    "*manage.py optimizemigration*",
    "*manage.py loaddata*",
    "*manage.py createsuperuser*",
    "*manage.py changepassword*",
    "*manage.py collectstatic*",
    "*manage.py createcachetable*",
    "*manage.py clearsessions*",
    "*manage.py remove_stale_contenttypes*",
    "*manage.py startapp*",
    "*manage.py startproject*",
    "*manage.py makemessages*",
    "*manage.py compilemessages*",
    "*manage.py shell*",
    "*manage.py dbshell*",
    "git merge *",
    "git reset *",
    "git rebase *",
    "git pull *--rebase*",
    "git pull -r*",
    "git pull * -r*",
    "git cherry-pick *",
    "git revert *",
    "git am *",
    "git update-ref *",
    "git branch -f*",
    "git branch * -f*",
    "git branch --force*",
    "git branch * --force*",
    "git branch -M*",
    "git branch * -M*",
    "git checkout -B*",
    "git switch -C*",
    "git switch --force-create*",
    "git -C * merge *",
    "git -C * reset *",
    "git -C * rebase *",
    "git -C * pull *--rebase*",
    "git -C * pull -r*",
    "git -C * pull * -r*",
    "git -C * cherry-pick *",
    "git -C * revert *",
    "git -C * am *",
    "git -C * update-ref *",
    "git -C * branch -f*",
    "git -C * branch * -f*",
    "git -C * branch --force*",
    "git -C * branch * --force*",
    "git -C * branch -M*",
    "git -C * branch * -M*",
    "git -C * checkout -B*",
    "git -C * switch -C*",
    "git -C * switch --force-create*",
    "git fetch *+*",
    "git fetch *--force*",
    "git fetch -f*",
    "git fetch * -f*",
    "git -C * fetch *+*",
    "git -C * fetch *--force*",
    "git -C * fetch -f*",
    "git -C * fetch * -f*"
  ],
  "deny": [
    "*manage.py flush*",
    "*manage.py sendtestemail*",
    "git push *main*",
    "git push *master*",
    "git push *--force*",
    "git push -f*",
    "git push * -f*",
    "git push *--delete*",
    "git push *--mirror*",
    "git -C * push *main*",
    "git -C * push *master*",
    "git -C * push *--force*",
    "git -C * push -f*",
    "git -C * push * -f*",
    "git -C * push *--delete*",
    "git -C * push *--mirror*",
    "*--no-verify*",
    "*core.hooksPath*",
    "*GIT_CONFIG_*",
    "gh gist create*",
    "gh repo create*--public*",
    "gh repo edit*--visibility*",
    "git commit -n*",
    "git commit * -n*",
    "git -C * commit -n*",
    "git -C * commit * -n*",
    "gh pr merge*"
  ]
}
