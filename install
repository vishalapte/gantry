#!/usr/bin/env python3
"""Install this checkout of gantry into Claude Code, Codex and Pi.

    ./install --agent NAME [--dry-run]

What goes where:

- shared/ (minus skills/) and pi/ -> ~/.gantry: AGENTS.md, hooks/, git-hooks/,
  permissions.json, env.json (with the agent's name in place of <agent>), pi/gantry-guard.ts.
- shared/skills/<name> -> ~/.agents/skills/<name>, which Codex and Pi read.
- Claude Code ($CLAUDE_CONFIG_DIR, else ~/.claude): every file under claude/;
  settings.json is claude/settings.json plus permissions.json as Bash(...) rules plus env.json;
  skills/<name> and git-hooks are links into the two homes above.
- Codex ($CODEX_HOME, else ~/.codex): AGENTS.md links to ~/.gantry/AGENTS.md; gantry's
  PreToolUse handler is merged into hooks.json beside any other; config.toml gets one marked
  block at the top (approval_policy, sandbox_mode, shell_environment_policy.set).
- Pi ($PI_CODING_AGENT_DIR, else ~/.pi/agent): AGENTS.md and extensions/gantry-guard.ts link
  into ~/.gantry.

Replace, not merge, for every file gantry ships: settings.json and CLAUDE.md are written whole,
which removes what other repos' installs put there, so run those again afterwards (racecar,
delphi). hooks.json and config.toml are the exceptions: only gantry's own entry or block
changes. Anything replaced that gantry did not write identically before is moved to
~/.gantry/backups/<timestamp>/ first. Paths gantry does not ship are never touched.

Installs what is in this checkout, uncommitted changes included, never a __pycache__.
"""

import json
import os
import re
import shutil
import sys
import time
import tomllib
from pathlib import Path

SRC = Path(__file__).resolve().parent
HOME = Path.home()
GANTRY = HOME / ".gantry"
AGENT_SKILLS = HOME / ".agents" / "skills"
CLAUDE = Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude")
CODEX = Path(os.environ.get("CODEX_HOME") or HOME / ".codex")
PI = Path(os.environ.get("PI_CODING_AGENT_DIR") or HOME / ".pi" / "agent")

GUARD_MARK = ".gantry/hooks/guard.py"
BLOCK_BEGIN = "# >>> gantry: written by gantry's ./install; edits inside this block are replaced"
BLOCK_END = "# <<< gantry"
CODEX_KEYS = ("approval_policy", "sandbox_mode", "shell_environment_policy")
NAME = re.compile(r"[a-z0-9_][a-z0-9_-]*")


class Refused(Exception):
    """A target holds something install will not overwrite."""


def parse_args(argv):
    agent, dry_run, args = None, False, list(argv)
    while args:
        arg = args.pop(0)
        if arg == "--dry-run":
            dry_run = True
        elif arg == "--agent":
            if not args:
                print("install: --agent needs a name", file=sys.stderr)
                sys.exit(2)
            agent = args.pop(0)
        elif arg.startswith("--agent="):
            agent = arg.removeprefix("--agent=")
        else:
            print(f"install: unknown argument: {arg} (only --agent NAME and --dry-run are "
                  "accepted)", file=sys.stderr)
            sys.exit(2)
    if agent is None:
        if not sys.stdin.isatty():
            print("install: no agent name; give --agent NAME", file=sys.stderr)
            sys.exit(2)
        agent = input("install: agent name, for <agent> in env.json: ").strip()
    if not NAME.fullmatch(agent):
        print(f"install: bad agent name '{agent}': use lowercase letters, digits, - and _",
              file=sys.stderr)
        sys.exit(2)
    return agent, dry_run


# --- What each target should hold -------------------------------------------------------
# A wanted entry is ("file", bytes, mode) or ("link", target).

def tree(root, skip=()):
    """Every file and symlink under `root`, as wanted entries keyed by relative path."""
    found = {}
    for path in sorted(root.rglob("*")):
        rel = path.relative_to(root)
        if "__pycache__" in rel.parts or (rel.parts and rel.parts[0] in skip):
            continue
        if path.is_symlink():
            found[rel] = ("link", os.readlink(path))
        elif path.is_file():
            found[rel] = ("file", path.read_bytes(), path.stat().st_mode & 0o777)
    return found


def text(content):
    return ("file", content.encode(), 0o644)


def render_env(agent):
    env = json.loads((SRC / "shared" / "env.json").read_text())
    return {key: value.replace("<agent>", agent) for key, value in env.items()}


def render_settings(env):
    settings = json.loads((SRC / "claude" / "settings.json").read_text())
    shell = json.loads((SRC / "shared" / "permissions.json").read_text())
    rules = settings.setdefault("permissions", {})
    for key in ("allow", "ask", "deny"):
        rules[key] = rules.get(key, []) + [f"Bash({glob})" for glob in shell.get(key, [])]
    settings["env"] = env
    return json.dumps(settings, indent=2, ensure_ascii=False) + "\n"


def merge_codex_hooks(existing):
    """hooks.json with gantry's one handler in the Bash PreToolUse group, every other kept."""
    ours = json.loads((SRC / "codex" / "hooks.json").read_text())
    handler = ours["hooks"]["PreToolUse"][0]["hooks"][0]
    data = json.loads(existing) if existing.strip() else {}
    groups = data.setdefault("hooks", {}).setdefault("PreToolUse", [])
    mine = [(g, h) for g in groups for h in g.get("hooks", [])
            if GUARD_MARK in str(h.get("command", ""))]
    if len(mine) == 1 and mine[0][1] == handler and mine[0][0].get("matcher") == "Bash":
        return existing
    for group, entry in mine:
        group["hooks"].remove(entry)
    groups[:] = [g for g in groups if g.get("hooks") or not any(g is m for m, _ in mine)]
    bash = next((g for g in groups if g.get("matcher") == "Bash"), None)
    if bash is None:
        groups.append({"matcher": "Bash", "hooks": [handler]})
    else:
        bash.setdefault("hooks", []).append(handler)
    return json.dumps(data, indent=2) + "\n"


def merge_codex_config(existing, env):
    """config.toml with gantry's block first; refused when its keys are set outside it."""
    lines = existing.splitlines(keepends=True)
    if any(line.startswith("# >>> gantry") for line in lines):
        start = next(i for i, line in enumerate(lines) if line.startswith("# >>> gantry"))
        end = next((i for i, line in enumerate(lines) if line.rstrip("\n") == BLOCK_END), None)
        if end is None or end < start:
            raise Refused(f"{CODEX / 'config.toml'}: gantry block has no end line '{BLOCK_END}'")
        lines = lines[:start] + lines[end + 1:]
        while lines and not lines[0].strip():
            lines.pop(0)
    rest = "".join(lines)
    top = True
    for line in lines:
        stripped = line.strip()
        if re.match(r"\[\[?\s*shell_environment_policy\b", stripped):
            raise Refused(f"{CODEX / 'config.toml'} already sets {stripped}; gantry sets "
                          "shell_environment_policy. Remove it there, or keep it and skip Codex.")
        if stripped.startswith("["):
            top = False
        key = re.match(r"([A-Za-z_]+)", stripped)
        if top and key and key.group(1) in CODEX_KEYS:
            raise Refused(f"{CODEX / 'config.toml'} already sets {key.group(1)}; gantry sets it "
                          "in its own block. Remove the line, then run ./install again.")
    pairs = ", ".join(f"{key} = {json.dumps(value)}" for key, value in env.items())
    block = (f"{BLOCK_BEGIN}\n"
             'approval_policy = "on-request"\n'
             'sandbox_mode = "workspace-write"\n'
             f"shell_environment_policy.set = {{ {pairs} }}\n"
             f"{BLOCK_END}\n")
    merged = block + ("\n" + rest if rest else "")
    try:
        tomllib.loads(merged)
    except tomllib.TOMLDecodeError as exc:
        raise Refused(f"{CODEX / 'config.toml'} would not parse with gantry's block: {exc}") \
            from exc
    return merged


def read(path):
    try:
        return path.read_text()
    except FileNotFoundError:
        return ""


def wanted(agent):
    """Every target path and what it should hold, plus the paths backed up before replacing."""
    env = render_env(agent)
    want = {}
    for rel, entry in tree(SRC / "shared", skip=("skills",)).items():
        want[GANTRY / rel] = entry
    want[GANTRY / "env.json"] = text(json.dumps(env, indent=2) + "\n")
    want[GANTRY / "pi" / "gantry-guard.ts"] = tree(SRC / "pi")[Path("gantry-guard.ts")]

    skills = sorted(p.name for p in (SRC / "shared" / "skills").iterdir() if p.is_dir())
    for name in skills:
        for rel, entry in tree(SRC / "shared" / "skills" / name).items():
            want[AGENT_SKILLS / name / rel] = entry
        want[CLAUDE / "skills" / name] = ("link", str(AGENT_SKILLS / name))

    for rel, entry in tree(SRC / "claude").items():
        want[CLAUDE / rel] = entry
    want[CLAUDE / "settings.json"] = text(render_settings(env))
    want[CLAUDE / "git-hooks"] = ("link", str(GANTRY / "git-hooks"))

    want[CODEX / "AGENTS.md"] = ("link", str(GANTRY / "AGENTS.md"))
    hooks = read(CODEX / "hooks.json")
    want[CODEX / "hooks.json"] = text(merge_codex_hooks(hooks))
    want[CODEX / "config.toml"] = ("file", merge_codex_config(read(CODEX / "config.toml"), env)
                                   .encode(), 0o600)

    want[PI / "AGENTS.md"] = ("link", str(GANTRY / "AGENTS.md"))
    want[PI / "extensions" / "gantry-guard.ts"] = ("link", str(GANTRY / "pi" / "gantry-guard.ts"))

    backed_up = {CLAUDE / "settings.json", CLAUDE / "CLAUDE.md", CODEX / "hooks.json",
                 CODEX / "config.toml", CODEX / "AGENTS.md", PI / "AGENTS.md"}
    return want, backed_up


# --- Comparing and writing ---------------------------------------------------------------

def holds(path, entry):
    if entry[0] == "link":
        return path.is_symlink() and os.readlink(path) == entry[1]
    if path.is_symlink() or not path.is_file():
        return False
    return path.read_bytes() == entry[1]


def move_aside(path, backup):
    """Move what is at `path` into the backup directory, keeping its path below HOME."""
    try:
        rel = path.relative_to(HOME)
    except ValueError:
        rel = Path(*path.parts[1:])
    target = backup / rel
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(path), str(target))
    return target


def write(path, entry, backup, backed_up):
    if path.is_symlink() or path.exists():
        if path in backed_up or path.is_dir() and not path.is_symlink():
            print(f"install: saved {path} in {move_aside(path, backup)}")
        else:
            path.unlink()
    path.parent.mkdir(parents=True, exist_ok=True)
    if entry[0] == "link":
        path.symlink_to(entry[1])
    else:
        path.write_bytes(entry[1])
        path.chmod(entry[2])


def main(argv):
    agent, dry_run = parse_args(argv)
    try:
        want, backed_up = wanted(agent)
    except Refused as exc:
        print(f"install: refused: {exc}", file=sys.stderr)
        return 1
    changed = [path for path, entry in want.items() if not holds(path, entry)]
    if not changed:
        print("install: Claude Code, Codex and Pi already match this checkout")
        return 0
    for path in changed:
        print(f"install: {'would replace' if dry_run else 'replacing'} {path}")
    if dry_run:
        return 0
    backup = GANTRY / "backups" / time.strftime("pre-install-%Y%m%d-%H%M%S")
    for path in changed:
        write(path, want[path], backup, backed_up)
    if (CODEX / "hooks.json") in changed:
        print("install: Codex runs a new or changed hook only after you trust it: open codex "
              "and run /hooks once")
    if not (HOME / ".claude" / "orgs.json").is_file():
        print(f"install: {HOME / '.claude' / 'orgs.json'} is missing, so every push an agent "
              "runs will be refused; copy orgs.example.json there and list your owners",
              file=sys.stderr)
    print("install: done. Now re-run each repo's ./install (racecar, delphi) to put back their "
          "hooks and imports.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
